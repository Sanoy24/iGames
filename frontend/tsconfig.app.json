{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Shared 8-ball engine imported from the backend (../src/pool). */
    "paths": {
      "@pool-engine": ["../src/pool/engine/index.ts"],
      "@pool-rules": ["../src/pool/rules/rules.ts"],
      "@pool-rules/types": ["../src/pool/rules/rules-types.ts"],
      "@pool-physics": ["../src/pool/pool-physics.ts"],
      "@werk-sim": ["../src/werk/sim/index.ts"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
