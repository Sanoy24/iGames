# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/igames

# ─── Redis ────────────────────────────────────────────────────────────────────
# Used for: distributed CRON lock, Socket.IO horizontal scaling
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_to_a_random_256bit_string
JWT_REFRESH_SECRET=change_me_to_another_random_256bit_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
TELEGRAM_MINIAPP_URL=https://t.me/your_miniapp_url

# Auth mode: telegram_only | standalone | hybrid
AUTH_MODE=telegram_only

# ─── TeleBirr Payments ────────────────────────────────────────────────────────
TELEBIRR_EXPECTED_RECEIVER_NAME=Your Business Name
TELEBIRR_EXPECTED_RECEIVER_ACCOUNT=0912345678
TELEBIRR_CREDIT_MINOR_PER_BIRR=100

# ─── Security & CORS ──────────────────────────────────────────────────────────
# In production, set this to your actual frontend URL
ALLOWED_ORIGIN=https://your-frontend-domain.com

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Max THROTTLE_MAX_REQUESTS requests per THROTTLE_TTL_SECONDS per IP
THROTTLE_TTL_SECONDS=60
THROTTLE_MAX_REQUESTS=120

# ─── Sentry Error Tracking ────────────────────────────────────────────────────
# Get your DSN from https://sentry.io — leave blank to disable
SENTRY_DSN=
