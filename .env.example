# Application
NODE_ENV=development
PORT=3000

# Database
# Use this with docker-compose.dev.yml.
MONGODB_URI=mongodb://localhost:27018/igames?replicaSet=rs0

# Redis
# Used for distributed scheduler locks and Socket.IO horizontal scaling.
REDIS_URL=redis://localhost:6380

# JWT
JWT_ACCESS_SECRET=change_me_to_a_random_256bit_string
JWT_REFRESH_SECRET=change_me_to_another_random_256bit_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
TELEGRAM_MINIAPP_URL=https://t.me/your_miniapp_url

# Auth mode: telegram_only | standalone | hybrid
AUTH_MODE=telegram_only

# Telebirr payments
TELEBIRR_EXPECTED_RECEIVER_NAME=Your Business Name
TELEBIRR_EXPECTED_RECEIVER_ACCOUNT=0912345678
TELEBIRR_CREDIT_MINOR_PER_BIRR=100

# Security and CORS
# In production, set this to your actual frontend URL.
ALLOWED_ORIGIN=http://localhost:5173

# Rate limiting
# Max THROTTLE_MAX_REQUESTS requests per THROTTLE_TTL_SECONDS per IP.
THROTTLE_TTL_SECONDS=60
THROTTLE_MAX_REQUESTS=120

# Sentry error tracking
# Leave blank to disable.
SENTRY_DSN=
