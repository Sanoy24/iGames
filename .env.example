NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/igames?replicaSet=rs0
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
TELEGRAM_MINIAPP_URL=https://your-domain.com/miniapp
AUTH_MODE=hybrid
TELEBIRR_EXPECTED_RECEIVER_NAME=Your Business Name
TELEBIRR_EXPECTED_RECEIVER_ACCOUNT=09xxxxxxxx
TELEBIRR_CREDIT_MINOR_PER_BIRR=100
