# Application
NODE_ENV=production
PORT=3000

# ── MySQL Database (cPanel MySQL) ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=cpanelusername_dbuser
DB_PASSWORD=your_strong_db_password
DB_DATABASE=cpanelusername_igames

# ── Redis ────────────────────────────────────────────────────────────────────
# Used for distributed scheduler locks and Socket.IO horizontal scaling.
# cPanel: install Redis via Softaculous or ask your host; typical local socket URL:
REDIS_URL=redis://127.0.0.1:6379

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change_me_to_a_random_256bit_string
JWT_REFRESH_SECRET=change_me_to_another_random_256bit_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
TELEGRAM_MINIAPP_URL=https://yourdomain.com

# Auth mode: telegram_only | standalone | hybrid
AUTH_MODE=hybrid

# ── Telebirr payments ─────────────────────────────────────────────────────────
TELEBIRR_EXPECTED_RECEIVER_NAME=Your Business Name
TELEBIRR_EXPECTED_RECEIVER_ACCOUNT=0912345678
TELEBIRR_CREDIT_MINOR_PER_BIRR=100

# Egress proxy that fetches Telebirr receipt HTML for hosts that cannot reach
# transactioninfo.ethiotelecom.et directly. The backend calls
# GET ${TELEBIRR_PROXY_URL}/fetchreceipt?receiptNo=... and expects { html }.
# Leave TELEBIRR_PROXY_URL blank to fetch Ethiotelecom directly (default).
# TELEBIRR_PROXY_KEY is optional (only if the proxy enforces a key); blank = none.
TELEBIRR_PROXY_URL=https://hawassayehiwotbirhan.et/api/tbrc
TELEBIRR_PROXY_KEY=
TELEBIRR_PROXY_TIMEOUT_MS=15000

# ── M-Pesa payments ───────────────────────────────────────────────────────────
# M-Pesa deposits/payouts are verified from the confirmation SMS the player/agent
# pastes. MPESA_PORTAL_ENABLED turns ON an AUTHORITATIVE cross-check against the
# real Safaricom receipt (the URL in the SMS): the backend fetches
#   GET https://m-pesabusiness.safaricom.et/api/receipt/getReceipt?trxNo=<code>
# which returns a base64 PDF; its text layer is UNMASKED, so the receiver phone and
# settled amount are confirmed exactly. responseCode "0" also proves the code is a
# real, settled transaction (a forged SMS code is rejected).
#   MPESA_PORTAL_ENABLED=false → SMS-only (deduped, receiver matched to an agent).
#   MPESA_PORTAL_URL blank     → fetch Safaricom directly; set it to route through an
#                                egress proxy (GET ${MPESA_PORTAL_URL}/getreceipt?code=…
#                                returning the same JSON) for hosts that can't reach
#                                Safaricom directly. MPESA_PORTAL_KEY → x-portal-key.
#   MPESA_PORTAL_STRICT=true   → a portal OUTAGE blocks the deposit (like Telebirr);
#                                false → outage falls back to the SMS.
MPESA_PORTAL_ENABLED=false
MPESA_PORTAL_URL=
MPESA_PORTAL_KEY=
MPESA_PORTAL_TIMEOUT_MS=15000
MPESA_PORTAL_STRICT=false

# ── Security and CORS ────────────────────────────────────────────────────────
# Set this to your actual frontend URL in production.
ALLOWED_ORIGIN=https://yourdomain.com

# ── Rate limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_MAX_REQUESTS=120

# ── Sentry error tracking ─────────────────────────────────────────────────────
# Leave blank to disable.
SENTRY_DSN=
