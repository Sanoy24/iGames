{
  "name": "igames-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS + MySQL backend for iGames Keno and 90-ball Bingo.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "schema:sync": "node dist/scripts/ensure-schema.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:unit": "jest src/keno/keno-rules.service.spec.ts src/bingo/bingo-rules.service.spec.ts src/bingo/bingo-leaderboard.spec.ts src/rng/rng.service.spec.ts src/wallet/wallet.service.spec.ts src/crash/crash.service.spec.ts src/keno/keno.service.spec.ts src/bingo/bingo.service.spec.ts --forceExit --no-coverage",
    "test:unit:watch": "jest src/keno/keno-rules.service.spec.ts src/bingo/bingo-rules.service.spec.ts src/bingo/bingo-leaderboard.spec.ts src/rng/rng.service.spec.ts src/wallet/wallet.service.spec.ts src/crash/crash.service.spec.ts src/keno/keno.service.spec.ts src/bingo/bingo.service.spec.ts --watch",
    "seed:dev": "node scripts/seed-dev.mjs",
    "seed:bingo-patterns": "ts-node scripts/seed-bingo-patterns.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.20",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.2",
    "@nestjs/websockets": "^11.1.20",
    "@sentry/nestjs": "^10.53.1",
    "@sentry/node": "^10.53.1",
    "@sentry/profiling-node": "^10.53.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "grammy": "^1.42.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "mysql2": "^3.22.5",
    "nest-winston": "^1.10.2",
    "prom-client": "^15.1.3",
    "redlock": "^5.0.0-beta.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "telebirr-receipt": "^0.0.1",
    "typeorm": "^0.3.30",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.0.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
