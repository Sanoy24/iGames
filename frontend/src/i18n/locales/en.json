  "faq": {
    "keno": {
      "q": "How does Keno work?",
      "a": "Pick 1–12 numbers from 1–80. When the draw runs, 20 numbers are randomly selected. Your payout depends on how many of your picks match."
    },
    "bingo": {
      "q": "How does Bingo work?",
      "a": "Join a room and buy tickets. Numbers are drawn one at a time. Match one row, two rows, or a full card to win prize tiers."
    },
    "currency": {
      "q": "What currency does the app use?",
      "a": "All balances, stakes, and payouts are shown in ETB (Ethiopian Birr)."
    },
    "deposit": {
      "q": "How do I deposit?",
      "a": "Wallet → Deposit (Telebirr). Send the amount to the agent on duty, then paste the SMS confirmation to instantly credit your account."
    },
    "withdraw": {
      "q": "How do I withdraw?",
      "a": "Wallet → Withdraw. Enter the amount and your Telebirr phone number. An agent processes the transfer."
    },
    "instant": {
      "q": "Are winnings instant?",
      "a": "Yes — credited to your wallet immediately after each draw or room settlement."
    }
  },
